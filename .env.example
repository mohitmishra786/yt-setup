# yt-studio secrets — copy to .env and fill in. Never commit .env.

# Anthropic (scriptwriter, chapters, SEO, thumbnail concepts)
ANTHROPIC_API_KEY=

# Hugging Face (pyannote diarization used by WhisperX when diarize=true)
HF_TOKEN=

# Optional: ElevenLabs paid TTS fallback
ELEVENLABS_API_KEY=

# Optional: Vantage shorts engine (if auth is required)
VANTAGE_API_URL=http://127.0.0.1:8080
VANTAGE_API_KEY=

# YouTube Data API OAuth (client secrets file path also set in config.yaml)
# Place OAuth desktop client JSON at .credentials/client_secret.json
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
